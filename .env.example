# Email / SMTP Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=danielius@zajenckauskas.lt
SMTP_PASS=your-smtp-password
SMTP_FROM="Danielius Zajenčkauskas <danielius@zajenckauskas.lt>"

# Doodle submissions default to the public profile email when this is omitted.
DOODLE_RECIPIENT_EMAIL=danielius@zajenckauskas.lt

# Cloudflare Turnstile development keys. Replace both with keys registered for
# the production domain before deploying. Production rejects these test keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Umami Analytics. Sign up at umami.is (or self-host) and create a website
# to get these values. Get your own website ID — don't reuse someone else's.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
